+++ b/internal/protocol/http/stall_dialer.go
+package http
+
+import (
+	"context"
+	"net"
+	"time"
+)
+
+// ============================================================================
+// autoDeadlineDialer: kernel-level per-read stall timeouts
+// ============================================================================
+//
+// The upstream design enforced read-stall timeouts with TimeoutReader, which
+// spawned a goroutine + context + channel per Read call. At 512 connections
+// that is tens of thousands of goroutine churn per second.
+//
+// This dialer instead wraps the raw TCP conn returned by net.Dialer BEFORE TLS
+// wraps it, and arms a kernel read deadline before every Read. Key properties:
+//
+//   - The wrapper stays BELOW tls.Conn, so transport's `pconn.conn.(*tls.Conn)`
+//     type assertion and HTTP/2 upgrade keep working untouched.
+//   - Deadline is armed per Read (like a sliding stall window): a healthy
+//     stream always receives data well within the window; a stalled stream
+//     gets EWOULDBLOCK->timeout error at kernel level, which surfaces as a
+//     normal io error to the caller for retry.
+//   - Write side gets its own sliding window so a stuck upload does not hang
+//     forever either.
+//   - Zero goroutines, zero allocations per read.
+
+const (
+	defaultStallTimeout = 15 * time.Second // matches upstream readTimeout
+)
+
+// stallConn wraps a net.Conn arming sliding read/write deadlines.
+type stallConn struct {
+	net.Conn
+	stall time.Duration
+}
+
+func (c *stallConn) Read(b []byte) (int, error) {
+	// Arm/extend the read deadline for this read only. Sliding window: a slow
+	// but progressing stream never trips it; a stalled one does.
+	if err := c.Conn.SetReadDeadline(time.Now().Add(c.stall)); err != nil {
+		return 0, err
+	}
+	return c.Conn.Read(b)
+}
+
+func (c *stallConn) Write(b []byte) (int, error) {
+	if err := c.Conn.SetWriteDeadline(time.Now().Add(c.stall)); err != nil {
+		return 0, err
+	}
+	return c.Conn.Write(b)
+}
+
+// autoDeadlineDialer returns a DialContext that wraps every dialed conn with
+// sliding stall deadlines. dialTimeout is only for connection establishment.
+func autoDeadlineDialer(dialTimeout time.Duration) func(ctx context.Context, network, addr string) (net.Conn, error) {
+	d := &net.Dialer{
+		Timeout:   dialTimeout,
+		KeepAlive: 30 * time.Second,
+	}
+	return func(ctx context.Context, network, addr string) (net.Conn, error) {
+		conn, err := d.DialContext(ctx, network, addr)
+		if err != nil {
+			return nil, err
+		}
+		return &stallConn{Conn: conn, stall: defaultStallTimeout}, nil
+	}
+}

