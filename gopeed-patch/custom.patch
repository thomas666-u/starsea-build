--- /dev/null
+++ b/internal/protocol/http/buffered_writer.go
+package http
+
+import (
+	"os"
+	"sync"
+	"time"
+)
+
+// ============================================================================
+// bufferedWriter: batched sequential WriteAt for chunked downloads
+// ============================================================================
+//
+// Fork perf: at 512 connections the naive one-WriteAt-per-Read design issues
+// thousands of small pwrite syscalls per second. bufferedWriter coalesces
+// consecutive writes into larger pwrite batches while keeping on-disk
+// progress observable:
+//
+//   - Writes land in an in-memory staging buffer while they are contiguous
+//     (the common case: a connection streams a chunk sequentially).
+//   - The stage flushes when it is full, on a non-contiguous offset (work
+//     stealing split the chunk), on explicit Flush, or after a short idle
+//     window with no new writes (autoFlushDelay). The idle flush is what
+//     keeps small/slow streams visible on disk - a 7-byte first line of an
+//     unknown-size stream must appear promptly for progress reporting.
+//   - Correctness: never reorders (contiguity check forces a flush on any
+//     gap), shares the *os.File but serializes flushes under one mutex.
+
+const (
+	defaultWriteStageSize = 512 * 1024
+	autoFlushDelay        = 30 * time.Millisecond
+)
+
+type bufferedWriter struct {
+	file *os.File
+	mu   sync.Mutex
+
+	stage     []byte
+	stageOff  int64 // file offset of stage[0]
+	stageUsed int
+
+	flushTimer   *time.Timer
+	timerPending bool
+}
+
+func newBufferedWriter(file *os.File) *bufferedWriter {
+	return &bufferedWriter{
+		file:  file,
+		stage: make([]byte, defaultWriteStageSize),
+	}
+}
+
+// WriteAt buffers contiguous writes and flushes when full or non-contiguous.
+func (w *bufferedWriter) WriteAt(p []byte, off int64) error {
+	if len(p) == 0 {
+		return nil
+	}
+
+	w.mu.Lock()
+	defer w.mu.Unlock()
+
+	// Non-contiguous with staged data: flush first, then stage the new run.
+	if w.stageUsed > 0 && off != w.stageOff+int64(w.stageUsed) {
+		if err := w.flushLocked(); err != nil {
+			return err
+		}
+	}
+
+	// Huge write: bypass staging entirely.
+	if len(p) >= len(w.stage) {
+		if err := w.flushLocked(); err != nil {
+			return err
+		}
+		_, err := w.file.WriteAt(p, off)
+		return err
+	}
+
+	// Stage the data, flushing when the stage fills up.
+	for len(p) > 0 {
+		if w.stageUsed == 0 {
+			w.stageOff = off
+		}
+		n := copy(w.stage[w.stageUsed:], p)
+		w.stageUsed += n
+		p = p[n:]
+		off += int64(n)
+		if w.stageUsed == len(w.stage) {
+			if err := w.flushLocked(); err != nil {
+				return err
+			}
+		}
+	}
+
+	// Arm the idle auto-flush so small writes become visible promptly even
+	// if no further reads arrive for a while.
+	w.armAutoFlushLocked()
+	return nil
+}
+
+// Flush persists any staged bytes.
+func (w *bufferedWriter) Flush() error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.flushLocked()
+}
+
+func (w *bufferedWriter) flushLocked() error {
+	w.stopAutoFlushLocked()
+	if w.stageUsed == 0 {
+		return nil
+	}
+	_, err := w.file.WriteAt(w.stage[:w.stageUsed], w.stageOff)
+	w.stageUsed = 0
+	return err
+}
+
+func (w *bufferedWriter) armAutoFlushLocked() {
+	if w.timerPending {
+		return
+	}
+	w.timerPending = true
+	w.flushTimer = time.AfterFunc(autoFlushDelay, func() {
+		w.mu.Lock()
+		defer w.mu.Unlock()
+		w.timerPending = false
+		if w.stageUsed > 0 {
+			_ = w.flushLocked()
+		}
+	})
+}
+
+func (w *bufferedWriter) stopAutoFlushLocked() {
+	if w.timerPending && w.flushTimer != nil {
+		w.flushTimer.Stop()
+		w.timerPending = false
+	}
+}

